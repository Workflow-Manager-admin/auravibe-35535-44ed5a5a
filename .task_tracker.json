n      "isEnabled": true\n    },\n    {\n      "name": "Direct Messaging",\n      "description": "1-on-1 chat with media sharing, powered by Socket.io or Firebase Realtime DB.",\n      "isEnabled": true\n    },\n    {\n      "name": "Dark/Light Mode",\n      "description": "Toggle between dark and light modes for personalized experience.",\n      "isEnabled": true\n    },\n    {\n      "name": "Admin Dashboard",\n      "description": "Admin tools to monitor reports or flagged content for community safety.",\n      "isEnabled": true\n    },\n    {\n      "name": "Responsive UI/UX",\n      "description": "Optimized for both mobile and desktop with smooth animations and hover effects.",\n      "isEnabled": true\n    },\n    {\n      "name": "Audio Reels",\n      "description": "Create and share short audio reels as an optional feature.",\n      "isEnabled": true\n    },\n    {\n      "name": "AI-generated Captions/Hashtags",\n      "description": "Suggest captions or hashtags using AI for posts.",\n      "isEnabled": true\n    },\n    {\n      "name": "Post Scheduling",\n      "description": "Schedule posts to be published at a later time.",\n      "isEnabled": true\n    }\n  ],\n  "techStack": {\n    "frontend": [\n      "React JS"\n    ],\n    "backend": [\n      "None"\n    ],\n    "language": [\n      "JavaScript (ES6+)"\n    ]\n  },\n  "colors": {\n    "primary": "#000000",\n    "secondary": "#FFFFFF",\n    "accent": "#780707"\n  },\n  "theme": "dark",\n  "layoutDescription": "The UI features a black background with all text in white Times New Roman font. The main feed is center-aligned, with rounded cards for posts, smooth hover effects, and subtle animations. Navigation is on the left (desktop) or bottom (mobile), with quick access to feed, explore, notifications, and profile. Profile pages are customizable with color palettes and themes. Stories appear at the top in a horizontal scroll. Direct messages open in a modal or side panel. Admin dashboard is accessibl